# ========== Utility Functions ==========

def greek_heatmap_data(S_range: np.ndarray, sigma_range: np.ndarray,
                      K: float, T: float, r: float, q: float,
                      greek: str = 'delta',
                      option_type: str = 'call') -> np.ndarray:
    """
    Generate heatmap data for a specific Greek across spot and volatility
    
    Useful for visualizing Greek surfaces
    
    Args:
        S_range: Array of spot prices
        sigma_range: Array of volatilities
        K, T, r, q: Fixed option parameters
        greek: Which Greek to compute
        option_type: 'call' or 'put'
    
    Returns:
        2D array of Greek values [len(S_range) × len(sigma_range)]
    """
    calc = GreeksCalculator()
    heatmap = np.zeros((len(S_range), len(sigma_range)))
    
    for i, S in enumerate(S_range):
        for j, sigma in enumerate(sigma_range):
            greeks = calc.black_scholes_greeks(S, K, T, r, sigma, q, option_type)
            heatmap[i, j] = greeks[greek]
    
    return heatmap

def gamma_risk_limits(positions: List[Dict], S_range: np.ndarray) -> Dict:
    """
    Calculate gamma risk across spot price range
    
    Gamma risk: potential P&L from delta hedging
    
    Args:
        positions: List of position dictionaries
        S_range: Range of spot prices to test
    
    Returns:
        Dictionary with risk metrics
    """
    calc = GreeksCalculator()
    
    # Portfolio gamma at each spot
    gamma_profile = []
    
    for S in S_range:
        total_gamma = 0
        for pos in positions:
            greeks = calc.black_scholes_greeks(
                S, pos['K'], pos['T'], pos['r'], pos['sigma'], 
                pos.get('q', 0), pos['option_type']
            )
            total_gamma += pos['weight'] * greeks['gamma']
        
        gamma_profile.append(total_gamma)
    
    gamma_profile = np.array(gamma_profile)
    
    return {
        'spot_range': S_range,
        'gamma_profile': gamma_profile,
        'max_gamma': np.max(np.abs(gamma_profile)),
        'gamma_at_current': gamma_profile[len(gamma_profile)//2] if len(gamma_profile) > 0 else 0
    }
